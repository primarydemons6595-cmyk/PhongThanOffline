function main()
    Say("Van Tien Tran ("..PT_LABEL.."): 02:20, 10:20, 13:20, 18:20, 21:20, 23:20. Dang ky 5 phut, chien dau 30 phut. Ban phuc hoi mien phi.",3,"Vao tran/pt_enter","Nhan thuong/pt_claim","Thoat/no")
