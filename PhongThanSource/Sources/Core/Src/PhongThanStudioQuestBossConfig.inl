struct QuestBossSpot {int x,y;};
struct QuestBoss {int id,type,map,level,respawn,enabled;std::string name;std::vector<QuestBossSpot> spots;};
static std::vector<QuestBoss> questBosses;
static bool LoadQuestBosses(KIniFile& ini,std::vector<QuestBoss>& next){int count=Int(ini,"QuestBosses","Count");if(count<0||count>32)return false;for(int i=1;i<=count;++i){char section[48];sprintf(section,"QuestBoss%d",i);QuestBoss b;b.id=Int(ini,section,"Id");b.type=Int(ini,section,"Template");b.map=Int(ini,section,"Map");b.level=Int(ini,section,"Level");b.respawn=Int(ini,section,"Respawn");b.enabled=Int(ini,section,"Enabled",1);b.name=Hex(ini,section,"NameHex");int spots=Int(ini,section,"SpotCount");if(b.id<1||b.type<1||b.type>=4096||b.map<1||b.level<1||b.level>200||b.respawn<1||b.respawn>86400||spots<1||spots>16||b.name.empty()||b.name.size()>31)return false;for(unsigned old=0;old<next.size();++old)if(next[old].id==b.id||next[old].type==b.type)return false;for(int s=1;s<=spots;++s){char key[24];QuestBossSpot p;sprintf(key,"X%d",s);p.x=Int(ini,section,key);sprintf(key,"Y%d",s);p.y=Int(ini,section,key);if(p.x<1||p.y<1)return false;b.spots.push_back(p);}next.push_back(b);}return true;}
