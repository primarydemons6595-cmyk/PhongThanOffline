static std::string Description(int p,const Quest& q){int status=Status(p,q);char number[120];std::string text=q.name;if(q.repeat==1){sprintf(number,"<enter>%d/%d",DailyUsed(p,q),q.dailyLimit);text+=number;}if(q.pointGain||q.pointCost){const ServicePoints* point=ServicePoint(services,q.point);if(point){sprintf(number,": %d (+%d / -%d)",Player[p].m_cTask.GetSaveVal(5230+q.point-1),q.pointGain,q.pointCost);text+="<enter>"+point->name+number;}}if(status>0&&status<=(int)q.steps.size()){const Step& step=q.steps[status-1];text+="<enter>"+step.name+"<enter>"+step.text;if(step.kind==1){int x=0,y=0;BossLocation(step.target,x,y);if(x&&y){sprintf(number,"<enter>(%d,%d)",x/256,y/512);text+=number;}}if(step.requiredSeal){Seal* seal=SealOps::Find(step.requiredSeal);if(seal){sprintf(number," (%ds)",SealOps::Remaining(p,step.requiredSeal));text+="<enter>"+seal->name+number;}}if(step.kind==1||step.kind==4){sprintf(number,"<enter>%d/%d",Raw(p,q)&CountMask,step.count);text+=number;if(step.kind==4){if(!step.needs.empty())text+="<enter>"+step.needs[0].name;for(unsigned k=0;k<step.keys.size();++k){sprintf(number," (%d/%d)",Owned(p,step.keys[k].row),step.keys[k].row.count);text+="<enter>"+step.keys[k].name+number;}}}else if(step.kind==2||step.kind==3){for(unsigned i=0;i<step.needs.size();++i){sprintf(number,"<enter>%d/%d",Owned(p,step.needs[i].row),step.needs[i].row.count);text+=step.needs[i].name+number;}}else {Binding* npc=Bind(step.npc);if(npc){sprintf(number," (%d,%d)",npc->x/256,npc->y/512);text+="<enter>"+npc->name+number;}}}else if(status>(int)q.steps.size())text+="<enter>"+q.complete;return text;}
static void Journal(int p,const Quest& q,int action=1){std::string text=Description(p,q);if(text.size()>1800)text.resize(1800);SendPhongThanTaskRecord(p,FirstTask+q.id-1,Status(p,q),action,text.c_str());}
