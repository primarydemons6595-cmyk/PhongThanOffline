static Quest* Find(int id){for(unsigned i=0;i<quests.size();++i)if(quests[i].id==id&&quests[i].enabled)return &quests[i];return 0;}
static Binding* Bind(int id){for(unsigned i=0;i<bindings.size();++i)if(bindings[i].id==id)return &bindings[i];return 0;}
static bool Live(int p){return p>0&&p<MAX_PLAYER&&Player[p].m_PlayerDBLoad&&Player[p].m_dwID&&Player[p].m_nIndex>0&&Player[p].m_nIndex<MAX_NPC&&Npc[Player[p].m_nIndex].IsPlayer()&&Npc[Player[p].m_nIndex].m_SubWorldIndex>=0&&Npc[Player[p].m_nIndex].m_SubWorldIndex<MAX_SUBWORLD;}
static int Class(int p){int type=Npc[Player[p].m_nIndex].m_Series;return type>=0&&type<3?1<<type:0;}
static int Raw(int p,const Quest& q){return Player[p].m_cTask.GetSaveVal(FirstTask+q.id-1);}
static int Day(){return (int)((time(NULL)+25200)/86400)&CountMask;}
static int Pack(const Quest& q,int stage,int progress=0){return (q.generation<<GenerationShift)|(stage<<StageShift)|progress;}
static int Stage(int raw){return (raw>>StageShift)&63;}
static int Skip(int p,const Quest& q,int stage){while(stage<=(int)q.steps.size()&&!(q.steps[stage-1].classes&Class(p)))++stage;return stage;}
static int DailyUsed(int p,const Quest& q){int raw=Raw(p,q);if(q.dailyCounter){int task=Player[p].m_cTask.GetSaveVal(5247+q.dailyCounter-1);if(task&&((task>>6)&CountMask)==Day())return task&63;if(Player[p].m_cTask.GetSaveStr(5247+q.dailyCounter-1)[0])return 0;}return (raw&Done)&&(raw&CountMask)==Day()?1:0;}
static int StartStage(int p,const Quest& q){if(!q.randomBranches)return Skip(p,q,1);int starts[16],count=0,branch=0;for(unsigned i=0;i<q.steps.size();++i){const Step& step=q.steps[i];if(step.branch!=branch){branch=step.branch;unsigned j=i;while(j<q.steps.size()&&q.steps[j].branch==branch&&!(q.steps[j].classes&Class(p)))++j;if(j<q.steps.size()&&q.steps[j].branch==branch)starts[count++]=j+1;}}return count?starts[g_Random(count)]:(int)q.steps.size()+1;}
static int Advance(int p,const Quest& q,int stage){if(!q.randomBranches)return Skip(p,q,stage+1);int branch=q.steps[stage-1].branch;for(unsigned i=stage;i<q.steps.size()&&q.steps[i].branch==branch;++i)if(q.steps[i].classes&Class(p))return i+1;return q.steps.size()+1;}
static int Status(int p,const Quest& q){if(!Live(p)||!(q.classes&Class(p)))return -1;int raw=Raw(p,q);if(raw&Done){if(q.repeat==3)return 0;if(q.repeat==1&&DailyUsed(p,q)<q.dailyLimit)return 0;if(q.repeat==2&&((raw&CountMask)+3)/7!=(Day()+3)/7)return 0;return -1;}if(!raw)return 0;if(((raw>>GenerationShift)&255)!=q.generation||!Stage(raw))return -2;return Stage(raw);}
static bool Eligible(int p,const Quest& q){if(!Live(p)||!(q.classes&Class(p)))return false;int level=Npc[Player[p].m_nIndex].m_Level;if(level<q.minLevel||level>q.maxLevel)return false;if(q.prerequisite){if(q.prerequisite<1||q.prerequisite>MaxQuests||!(Player[p].m_cTask.GetSaveVal(FirstTask+q.prerequisite-1)&Done))return false;}return true;}
static bool Near(int p,const Binding& b){if(!Live(p))return false;int actor=Player[p].m_nIndex,n=Player[p].m_nLastNpcIndex;if(n<=0||n>=MAX_NPC||Npc[n].IsPlayer()||Npc[n].m_Kind!=kind_dialoger||!Npc[n].m_dwID||Npc[n].m_RegionIndex<0||Npc[n].m_NpcSettingIdx!=b.type||Npc[n].m_SubWorldIndex!=Npc[actor].m_SubWorldIndex||SubWorld[Npc[n].m_SubWorldIndex].m_SubWorldID!=b.map)return false;int x,y;Npc[n].GetMpsPos(&x,&y);if(abs(x-b.x)>192||abs(y-b.y)>192)return false;int distance=NpcSet.GetDistance(actor,n);return distance>=0&&distance<=384;}
static bool ServiceTaskRoom(int p,int extra){int used=0;for(int i=0;i<MAX_TASK;++i)if(Player[p].m_cTask.GetSaveStr(i)[0])++used;return used+extra<=254;}
static bool MenuAccess(int p,int quest,int npc){bool custom=false;for(unsigned i=0;i<services.menus.size();++i){const ServiceMenu& m=services.menus[i];if(m.npc!=npc)continue;custom=true;if(m.kind==1&&m.quest==quest&&(m.classes&Class(p)))return true;}return !custom;}
static bool PointRoom(int p,int id){return !id||Player[p].m_cTask.GetSaveStr(5230+id-1)[0]||ServiceTaskRoom(p,1);}
static int Owned(int p,const PhongThanQuestExchangeRow& row){PTF2BalanceQuery q;q.Type=2;q.Genre=row.item.genre;q.Detail=row.item.detail;q.Particular=row.item.particular;q.Level=row.item.level<0?0:row.item.level;q.Series=row.item.series<0?0:row.item.series;return PhongThanF2WalletCount(p,q);}
